{
  "manifest_version": 3,
  "name": "Forti Vault",
  "version": "1.1",
  "permissions": [
    "storage",
    "tabs",
    "notifications",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "*://*/*",
  "https://safebrowsing.googleapis.com/*"

  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": "icons/icon128.png"
  }
}
